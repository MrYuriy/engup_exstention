{
  "manifest_version": 3,
  "name": "LangUp",
  "version": "2.0",
  "description": "Зберігай слова з вебсторінок у LangUp та вчи їх з контекстом.",
  "permissions": ["storage", "identity", "contextMenus"],
  "host_permissions": ["https://langup.piatek-magazyn.com/*"],
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LangUp — зберегти слово",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
