{
  "manifest_version": 3,
  "name": "LangUp",
  "version": "2.0",
  "description": "Зберігай слова з вебсторінок у LangUp та вчи їх з контекстом.",
  "permissions": ["storage", "identity", "activeTab", "contextMenus"],
  "host_permissions": ["https://langup-backend.onrender.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
